# Copy to .env and fill in. See docs/SETUP.md for how to get each value.

# Shared
PORT=3000
WEBHOOK_VERIFY_TOKEN=choose-any-long-random-string

# WhatsApp Business Platform (Cloud API)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Instagram (via Meta Graph API / linked Facebook Page)
IG_PAGE_ACCESS_TOKEN=
IG_PAGE_ID=

# Behaviour
# When true, the bot logs replies but does NOT actually send them (safe testing).
DRY_RUN=true
# Hours the bot says a human is available, shown in handoff messages (Asia/Kuala_Lumpur).
SUPPORT_HOURS=Mon–Fri, 10am–6pm (MYT)

# Optional: Shopify order lookups for "where is my order" intent
SHOPIFY_STORE_DOMAIN=hojichaya.com
SHOPIFY_ADMIN_TOKEN=
