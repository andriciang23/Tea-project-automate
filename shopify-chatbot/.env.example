# Copy to .env and fill in. See ../docs/SETUP.md and this folder's README.

PORT=3100

# --- LLM mode (optional but recommended) ---
# If ANTHROPIC_API_KEY is set, the bot answers free-form questions with Claude,
# grounded in the shared FAQ + product catalog. If unset, it falls back to the
# free keyword matcher (no API calls, still works).
ANTHROPIC_API_KEY=
# Model for the chatbot. Default is claude-opus-4-8 (most capable). For a cheaper,
# faster customer-facing bot you may set claude-haiku-4-5.
CHATBOT_MODEL=claude-opus-4-8

# --- Security ---
# Comma-separated list of origins allowed to call /chat (your storefront).
# Use your real domains in production. "*" allows any origin (dev only).
ALLOWED_ORIGINS=https://hojichaya.com,https://www.hojichaya.com

# Simple per-IP rate limit (requests per minute) to cap abuse/cost.
RATE_LIMIT_PER_MIN=20
