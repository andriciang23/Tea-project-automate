# ──────────────────────────────────────────────────────────────────────────
# Tea Project Automate — Unified Commerce Hub
# Copy this file to `.env` and fill in the credentials you have.
# The app runs with demo/seed data even if no credentials are set; each
# platform "activates" automatically once its keys are present.
# ──────────────────────────────────────────────────────────────────────────

# Database (SQLite by default; swap for a Postgres URL in production)
DATABASE_URL="file:./prisma/dev.db"

# ── Shopify (Admin API) ───────────────────────────────────────────────────
# Create a custom app in your Shopify admin → Settings → Apps and sales
# channels → Develop apps. Grant read/write for orders, products, inventory.
SHOPIFY_STORE_DOMAIN=""          # e.g. your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=""    # shpat_xxxxxxxx
SHOPIFY_API_VERSION="2024-10"

# ── Shopee (Open Platform) ────────────────────────────────────────────────
# Register at https://open.shopee.com — you need a partner_id + partner_key,
# then authorize your shop to obtain shop_id + an access_token.
SHOPEE_PARTNER_ID=""
SHOPEE_PARTNER_KEY=""
SHOPEE_SHOP_ID=""
SHOPEE_ACCESS_TOKEN=""
SHOPEE_REGION="SG"               # SG, MY, ID, TH, VN, PH, TW, BR ...
SHOPEE_HOST="https://partner.shopeemobile.com"  # use test host for sandbox

# ── Lazada (Open Platform) ────────────────────────────────────────────────
# Register at https://open.lazada.com — you need an App Key + App Secret,
# then authorize your seller account to obtain an access_token.
LAZADA_APP_KEY=""
LAZADA_APP_SECRET=""
LAZADA_ACCESS_TOKEN=""
LAZADA_REGION="SG"               # SG, MY, ID, TH, VN, PH
# Endpoint is derived from region, override here only if needed:
LAZADA_HOST=""
