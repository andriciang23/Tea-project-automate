# ---- WhatsApp Cloud API (Meta) ----
# Permanent access token for your Meta app's WhatsApp product
WHATSAPP_TOKEN=
# The phone-number ID of your WhatsApp business number (from the Meta dashboard)
WHATSAPP_PHONE_NUMBER_ID=
# A random string you choose; you enter the same value in the Meta webhook config
WHATSAPP_VERIFY_TOKEN=
# Your Meta app secret, used to verify the X-Hub-Signature-256 header
WHATSAPP_APP_SECRET=

# Comma-separated list of YOUR WhatsApp number(s) in E.164 form (no "+"), e.g. 6281234567890
# The bot only responds to these numbers and ignores everyone else.
ALLOWED_SENDERS=

# ---- Anthropic ----
ANTHROPIC_API_KEY=
# Optional: override the model (defaults to claude-opus-4-8)
ANTHROPIC_MODEL=claude-opus-4-8

# ---- Shopify Admin API (custom app) ----
# e.g. my-tea-shop.myshopify.com
SHOPIFY_STORE_DOMAIN=
# Admin API access token from your custom app
SHOPIFY_ADMIN_TOKEN=
# Admin API version
SHOPIFY_API_VERSION=2025-01

# ---- Server ----
PORT=3000
